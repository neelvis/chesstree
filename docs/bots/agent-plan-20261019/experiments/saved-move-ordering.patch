+        private fun savedMoveFirst(state: GameState, moves: List<Move>): List<Move> {
+            val hint = savedMoves?.get(state) ?: return moves
+            val saved = moves.firstOrNull { it.intent() == hint } ?: return moves
+            return if (saved == moves.first()) moves else listOf(saved) + moves.filter { it != saved }
+        }
+
+        private fun rememberSavedMove(state: GameState, move: Move?) {
