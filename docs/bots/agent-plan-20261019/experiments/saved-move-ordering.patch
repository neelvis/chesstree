+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertIs
+import kotlin.test.assertTrue
+
+class SavedMoveOrderingTest {
+    @Test
+    fun defaultIsDisabledAndMaxNWorkIsExactlyUnchangedWhenEnabled() {
+        val state = quietFixture(PlayerId.WHITE)
+        fun choose(enabled: Boolean? = null): Pair<BoundedBotResult, List<BoundedBotResult.Move>> {
+            val publications = mutableListOf<BoundedBotResult.Move>()
+            val bot = if (enabled == null) BoundedMaxNBot(maxDepth = 3, maxNodes = 100_000, maxEvaluations = 100_000)
+            else BoundedMaxNBot(maxDepth = 3, maxNodes = 100_000, maxEvaluations = 100_000,
+                useSavedMoveOrdering = enabled)
+            return bot.choose(state, onCompletedDepth = publications::add) to publications
+        }
+        assertEquals(choose(), choose(false))
+        assertEquals(choose(false), choose(true))
+    }
+
+    @Test
+    fun completedParanoidChoicesMatchAnExhaustiveReferenceForAllRootSeatsAndTies() {
+        val materialOnly = BotPolicy(listOf(BotRule(BotFeature.MATERIAL, 100)))
+        for (actor in PlayerId.entries) {
+            for (policy in listOf(materialOnly, BotPolicy.DEFAULT)) {
+                val state = quietFixture(actor)
+                val expected = exhaustiveRoot(state, 3, policy)
+                val plain = completed(state, policy, enabled = false)
+                val ordered = completed(state, policy, enabled = true)
+                assertEquals(expected, plain.intent)
+                assertEquals(expected, ordered.intent)
+                assertDecision(plain, ordered)
+                assertEquals(3, ordered.stats.completedDepth)
+                assertEquals(BotStopReason.DEPTH_COMPLETE, ordered.reason)
+                assertIs<MoveReduction.Applied>(GameReducer.reduce(state, ordered.intent))
+            }
+        }
+    }
+
+    @Test
+    fun openingRepertoireRootTiesAreUnchanged() {
+        val state = StandardGame.scenario.initialState
+        val zeroPolicy = BotPolicy(emptyList())
+        fun choose(enabled: Boolean) = assertIs<BoundedBotResult.Move>(BoundedMaxNBot(
+            maxDepth = 2, maxNodes = 100_000, maxEvaluations = 100_000,
+            searchModel = BotSearchModel.PARANOID, openingBookVersion = 1, seed = 123,
+            useSavedMoveOrdering = enabled,
+        ).choose(state, zeroPolicy))
+        val plain = choose(false)
+        assertDecision(plain, choose(true))
+        val legal = LegalMoveGenerator.legalMoves(state).map { it.intent() }
+        assertEquals(BotOpeningBook.preferredMoves(state, 123).first { it in legal }, plain.intent)
+    }
+
+    @Test
+    fun actualIntermediateResponsesAndCompletedDefenseArePreserved() {
+        val state = forcedRecapture()
+        val policy = BotPolicy(listOf(BotRule(BotFeature.MATERIAL, 100), BotRule(BotFeature.CHECK_PRESSURE, 40)))
+        fun choose(enabled: Boolean) = assertIs<BoundedBotResult.Move>(BoundedMaxNBot(
+            maxDepth = 1, maxNodes = 10_000, maxEvaluations = 10_000,
+            tacticalDepth = 2, searchModel = BotSearchModel.PARANOID,
+            useSavedMoveOrdering = enabled,
+        ).choose(state, policy))
+        val plain = choose(false)
+        val ordered = choose(true)
+        assertDecision(plain, ordered)
+        assertEquals(BotSearchHorizon.EXCHANGES, ordered.stats.completedHorizon)
+        val losingCapture = MoveIntent(PlayerId.WHITE, at("G10"), at("G12"))
+        assertTrue(ordered.intent != losingCapture)
+        assertIs<MoveReduction.Applied>(GameReducer.reduce(state, ordered.intent))
+    }
+
+    @Test
+    fun unresolvedThirdActorCheckStillDiscardsTheWholeAttempt() {
+        val state = forcedRecapture()
+        for (enabled in listOf(false, true)) {
+            val publications = mutableListOf<BoundedBotResult.Move>()
+            val result = assertIs<BoundedBotResult.Move>(BoundedMaxNBot(
+                maxDepth = 1, maxNodes = 10_000, maxEvaluations = 10_000,
+                tacticalDepth = 1, searchModel = BotSearchModel.PARANOID,
+                useSavedMoveOrdering = enabled,
+            ).choose(state, onCompletedDepth = publications::add))
+            assertEquals(BotMoveSource.LEGAL_FALLBACK, result.source)
+            assertEquals(BotStopReason.TACTICAL_LIMIT, result.reason)
+            assertEquals(0, result.stats.completedDepth)
+            assertTrue(publications.isEmpty())
+            assertIs<MoveReduction.Applied>(GameReducer.reduce(state, result.intent))
+        }
+    }
+
+    @Test
+    fun fixedWorkIsReproducibleAndInterruptedRequestsCannotRetainHints() {
+        val state = quietFixture(PlayerId.WHITE)
+        val bot = BoundedMaxNBot(maxDepth = 3, maxNodes = 100_000, maxEvaluations = 100_000,
+            searchModel = BotSearchModel.PARANOID, useSavedMoveOrdering = true)
+        val completed = bot.choose(state)
+        assertEquals(completed, bot.choose(state))
+        for (signal in listOf(BotStopSignal.CANCEL, BotStopSignal.TIMEOUT)) {
+            val publications = mutableListOf<BoundedBotResult.Move>()
+            val stopped = bot.choose(state, stop = BotStopProbe {
+                if (publications.any { it.stats.completedDepth == 2 }) signal else BotStopSignal.CONTINUE
+            }, onCompletedDepth = publications::add)
+            assertEquals(listOf(1, 2), publications.map { it.stats.completedDepth })
+            if (signal == BotStopSignal.CANCEL) {
+                assertEquals(2, assertIs<BoundedBotResult.Cancelled>(stopped).stats.completedDepth)
+            } else {
+                val move = assertIs<BoundedBotResult.Move>(stopped)
+                assertEquals(BotStopReason.TIMEOUT, move.reason)
+                assertEquals(publications.last().intent, move.intent)
+                assertEquals(2, move.stats.completedDepth)
+            }
+            assertEquals(completed, bot.choose(state))
+        }
+    }
+
+    @Test
+    fun refutationHintsPreserveCompletedDecisionsUnderDifferentNarrowRootWindows() {
+        // Several root candidates establish and tighten the Paranoid alpha window.
+        // A returned cutoff may supply a legal ordering hint, never an exact score.
+        for (policy in listOf(BotPolicy.DEFAULT,
+            BotPolicy(listOf(BotRule(BotFeature.MATERIAL, 100), BotRule(BotFeature.MOBILITY, 7))))) {
+            val state = quietFixture(PlayerId.BLACK)
+            val plain = completed(state, policy, enabled = false)
+            val ordered = completed(state, policy, enabled = true)
+            assertEquals(exhaustiveRoot(state, 3, policy), ordered.intent)
+            assertDecision(plain, ordered)
+            assertEquals(ordered, completed(state, policy, enabled = true))
+        }
+    }
+
+    @Test
+    fun completedChoicesRemainIndependentOfTheExactScoreCache() {
+        val state = quietFixture(PlayerId.RED)
+        val plain = completed(state, BotPolicy.DEFAULT, enabled = false)
+        val cache = BotSearchCache()
+        repeat(2) {
+            assertDecision(plain, completed(state, BotPolicy.DEFAULT, enabled = true, cache = cache))
+        }
+    }
+
+    private fun completed(
+        state: GameState,
+        policy: BotPolicy,
+        enabled: Boolean,
+        cache: BotSearchCache? = null,
+    ) = assertIs<BoundedBotResult.Move>(BoundedMaxNBot(
+        maxDepth = 3, maxNodes = 100_000, maxEvaluations = 100_000,
+        searchModel = BotSearchModel.PARANOID, cache = cache, useSavedMoveOrdering = enabled,
+    ).choose(state, policy))
+
+    private fun assertDecision(expected: BoundedBotResult.Move, actual: BoundedBotResult.Move) {
+        assertEquals(expected.intent, actual.intent)
+        assertEquals(expected.source, actual.source)
+        assertEquals(expected.reason, actual.reason)
+        assertEquals(expected.stats.completedDepth, actual.stats.completedDepth)
+        assertEquals(expected.stats.completedHorizon, actual.stats.completedHorizon)
+        assertEquals(expected.openingBook, actual.openingBook)
+        assertEquals(expected.repetitionPenalty, actual.repetitionPenalty)
+    }
+
+    private fun exhaustiveRoot(state: GameState, depth: Int, policy: BotPolicy): MoveIntent {
+        val actor = checkNotNull(state.turn).player
+        val scores = LegalMoveGenerator.legalMoves(state).map { move ->
+            move to exhaustive(apply(state, move), depth - 1, actor, policy)
+        }
+        return checkNotNull(scores.maxByOrNull { it.second }).first.intent()
+    }
+
+    private fun exhaustive(state: GameState, depth: Int, root: PlayerId, policy: BotPolicy): Double {
+        if (depth == 0 || state.phase != GamePhase.InProgress) {
+            return BotEvaluationMode.CONTROL.evaluate(state, policy)[root.ordinal]
+        }
+        val actor = checkNotNull(state.turn).player
+        val values = LegalMoveGenerator.legalMoves(state).map { move ->
+            exhaustive(apply(state, move), depth - 1, root, policy)
+        }
+        return if (actor == root) values.max() else values.min()
+    }
+
+    private fun apply(state: GameState, move: Move): GameState =
+        assertIs<MoveReduction.Applied>(GameReducer.reduce(state, move.intent())).state
+
+    private fun quietFixture(actor: PlayerId): GameState = state(actor, listOf(
+        piece("white-king", PieceType.KING, ArmyColor.WHITE, "H12"),
+        piece("red-king", PieceType.KING, ArmyColor.RED, "A1"),
+        piece("black-king", PieceType.KING, ArmyColor.BLACK, "N8"),
+        piece("white-pawn", PieceType.PAWN, ArmyColor.WHITE, "K9"),
+        piece("red-pawn", PieceType.PAWN, ArmyColor.RED, "D3"),
+        piece("black-pawn", PieceType.PAWN, ArmyColor.BLACK, "K6"),
+    ))
+
+    private fun forcedRecapture(): GameState = state(PlayerId.WHITE, listOf(
+        piece("a-white-rook", PieceType.ROOK, ArmyColor.WHITE, "G10"),
+        piece("white-king", PieceType.KING, ArmyColor.WHITE, "F12"),
+        piece("red-pawn", PieceType.PAWN, ArmyColor.RED, "G12"),
+        piece("red-king", PieceType.KING, ArmyColor.RED, "A2"),
+        piece("black-bishop", PieceType.BISHOP, ArmyColor.BLACK, "H11"),
+        piece("black-king", PieceType.KING, ArmyColor.BLACK, "H12"),
+    ))
+
+    private fun state(actor: PlayerId, pieces: List<Piece>) = GameState(
+        Position(pieces.associateBy(Piece::id)),
+        PlayerId.entries.associateWith(::Participant),
+        ArmyColor.entries.associateWith { ArmyControl(it, it.originalPlayer) },
+        Turn(actor, 1), GamePhase.InProgress,
+    )
+
+    private fun piece(id: String, type: PieceType, army: ArmyColor, label: String) =
+        Piece(PieceId(id), type, army, at(label), hasMoved = true)
+
+    private fun at(label: String) = checkNotNull(ThreePlayerBoardNotation.parse(label))
+    private fun Move.intent() = MoveIntent(actor, from, to, promotion)
+}
