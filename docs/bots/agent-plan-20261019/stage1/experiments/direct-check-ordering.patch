+    @Test
+    fun cancellationAndTimeoutRetainOnlyFullyCompletedAttempts() {
+        val state = checkFixture()
+        for (enabled in listOf(false, true)) {
+            val bot = bot()
+            val completed = bot.chooseWithDiagnostics(state, prioritizeDirectChecks = enabled, diagnostics = {})
+            for (signal in listOf(BotStopSignal.CANCEL, BotStopSignal.TIMEOUT)) {
+                val publications = mutableListOf<BoundedBotResult.Move>()
+                val stopped = bot.chooseWithDiagnostics(state, stop = BotStopProbe {
+                    if (publications.any { it.stats.completedDepth == 2 }) signal else BotStopSignal.CONTINUE
+                }, onCompletedDepth = publications::add, prioritizeDirectChecks = enabled, diagnostics = {})
+                assertEquals(listOf(1, 2), publications.map { it.stats.completedDepth })
+                if (signal == BotStopSignal.CANCEL) {
+                    assertEquals(2, assertIs<BoundedBotResult.Cancelled>(stopped).stats.completedDepth)
+                } else {
+                    val move = assertIs<BoundedBotResult.Move>(stopped)
+                    assertEquals(BotStopReason.TIMEOUT, move.reason)
+                    assertEquals(publications.last().intent, move.intent)
+                    assertEquals(2, move.stats.completedDepth)
+                }
+                assertEquals(completed, bot.chooseWithDiagnostics(state,
+                    prioritizeDirectChecks = enabled, diagnostics = {}))
+            }
+        }
+    }
