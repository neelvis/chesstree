+    @Test
+    fun optInDefaultKeepsTheExistingPublicParanoidPath() {
+        val state = checkFixture()
+        val bot = bot()
+        val public = bot.choose(state)
+        val disabled = bot.chooseWithDiagnostics(state, prioritizeDirectChecks = false, diagnostics = {})
+        val default = bot.chooseWithDiagnostics(state, diagnostics = {})
+        assertEquals(public, disabled)
+        assertEquals(disabled, default)
+    }
+
+    @Test
+    fun maxNResultsCallbacksDiagnosticsAndStopProbeCountsAreExactlyUnchanged() {
+        for (state in listOf(checkFixture(), quietFixture())) {
+            for (tacticalDepth in listOf(0, 1, 2)) {
+                val control = observe(state, BotSearchModel.MAX_N, enabled = false, tacticalDepth = tacticalDepth)
+                val ordered = observe(state, BotSearchModel.MAX_N, enabled = true, tacticalDepth = tacticalDepth)
+                assertEquals(control, ordered, "MAX_N q=$tacticalDepth")
+            }
+        }
+    }
+
+    @Test
+    fun completedParanoidChoicesMatchExhaustiveReferencesForEveryRootSeatAndPolicy() {
+        val policies = listOf(BotPolicy.DEFAULT, BotPolicy(listOf(BotRule(BotFeature.MATERIAL, 100))),
+            BotPolicy(emptyList()))
+        for (actor in PlayerId.entries) {
+            val state = checkFixture(actor)
+            val legal = LegalMoveGenerator.legalMoves(state)
+            assertTrue(directCheckPriorities(state, legal).values.any { it }, "$actor must exercise a checking hint")
+            assertTrue(directCheckPriorities(state, legal).values.any { !it }, "$actor must retain quiet alternatives")
+            for (policy in policies) {
+                val expected = exhaustiveRoot(state, 3, policy)
+                val plain = completed(state, policy, enabled = false)
+                val ordered = completed(state, policy, enabled = true)
+                assertEquals(expected, plain.intent, "$actor/control/$policy")
+                assertEquals(expected, ordered.intent, "$actor/ordered/$policy")
+                assertDecision(plain, ordered)
+                assertEquals(3, ordered.stats.completedDepth)
+                assertEquals(BotStopReason.DEPTH_COMPLETE, ordered.reason)
+                assertIs<MoveReduction.Applied>(GameReducer.reduce(state, ordered.intent))
+            }
+        }
+    }
+
+    @Test
+    fun repertoireRootTiesKeepTheirOriginalPolicy() {
+        val state = StandardGame.scenario.initialState
+        val policy = BotPolicy(emptyList())
+        fun choose(enabled: Boolean) = assertIs<BoundedBotResult.Move>(BoundedMaxNBot(
+            maxDepth = 2, maxNodes = 100_000, maxEvaluations = 100_000,
