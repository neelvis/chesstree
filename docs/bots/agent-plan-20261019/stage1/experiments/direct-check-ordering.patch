+package com.chesstree.game.domain.bot
+
+import com.chesstree.game.domain.GameState
+import com.chesstree.game.domain.LegalMoveGenerator
+import com.chesstree.game.domain.Move
+import com.chesstree.game.domain.ParticipantStatus
+import com.chesstree.game.domain.PieceType
+
+/**
+ * Ordering hints for an already legal move list belonging to the side to move.
+ * Detects attacks by the resulting moved piece, including its promoted type.
+ * Discovered checks and checks by a castling rook can remain false negatives.
+ * These hints neither validate moves nor replace the rules engine's check test.
+ */
+internal fun directCheckPriorities(
+    state: GameState,
+    moves: List<Move>,
+    shouldContinue: () -> Boolean = { true },
+): Map<Move, Boolean> {
+    val actor = state.turn?.player ?: return moves.associateWith { false }
+    // King targets are fixed for every legal move by this actor; kings cannot be captured.
+    val opposingKings = state.position.pieces.values.asSequence()
+        .filter { it.type == PieceType.KING }
+        .filter { king ->
+            val controller = state.armies.getValue(king.army).controller
+            controller != actor && state.participants.getValue(controller).status == ParticipantStatus.Active
+        }
+        .map { it.coordinate }
+        .toSet()
+    if (opposingKings.isEmpty()) return moves.associateWith { false }
+    val priorities = linkedMapOf<Move, Boolean>()
+    for (move in moves) {
+        if (!shouldContinue()) return emptyMap()
+        val after = LegalMoveGenerator.applyToPosition(state.position, move)
+        val movedPiece = after.pieces.getValue(move.pieceId)
+        priorities[move] = LegalMoveGenerator.attackCoordinates(after, movedPiece).any(opposingKings::contains)
+    }
+    return priorities
+}
