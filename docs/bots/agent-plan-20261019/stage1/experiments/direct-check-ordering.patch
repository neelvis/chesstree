+class BotTacticalMoveOrderingTest {
+    @Test
+    fun reportedKnightForkIsADirectCheckAndEveryLegalMoveRetainsAnEntry() {
+        val state = reportedKnightFork()
+        val moves = LegalMoveGenerator.legalMoves(state)
+        val fork = moves.single { it.from == at("H10") && it.to == at("G4") }
+        val priorities = directCheckPriorities(state, moves)
+        assertEquals(moves.toSet(), priorities.keys)
+        assertEquals(moves, priorities.keys.toList())
+        assertTrue(priorities.getValue(fork))
+        val after = apply(state, fork)
+        assertTrue(LegalMoveGenerator.isKingInCheck(after, PlayerId.WHITE))
+        val knight = after.position.pieces.getValue(fork.pieceId)
+        assertTrue(at("F2") in LegalMoveGenerator.attackCoordinates(after.position, knight))
+        assertTrue(moves.any { move ->
+            state.position.pieces.getValue(move.pieceId).type == PieceType.KING && !priorities.getValue(move)
+        })
+    }
+
+    @Test
+    fun aFrozenOpposingKingIsNotACheckTarget() {
+        val state = reportedKnightFork(whiteStatus = ParticipantStatus.Stalemated(atPly = 143))
+        val move = LegalMoveGenerator.legalMoves(state).single { it.from == at("H10") && it.to == at("G4") }
+        assertFalse(directCheckPriorities(state, listOf(move)).getValue(move))
+    }
+
+    @Test
+    fun aControlledKingIsNotAnOpposingTarget() {
+        val initial = reportedKnightFork()
+        val pieces = initial.position.pieces.values.map { piece ->
+            if (piece.id == PieceId("black-back-6")) piece.copy(army = ArmyColor.WHITE) else piece
+        }
+        val state = GameState(Position(pieces.associateBy(Piece::id)), initial.participants,
+            initial.armies, Turn(PlayerId.WHITE, 144), initial.phase)
+        val move = LegalMoveGenerator.legalMoves(state).single { it.from == at("H10") && it.to == at("G4") }
+        assertFalse(directCheckPriorities(state, listOf(move)).getValue(move))
+    }
+
+    @Test
+    fun transferredPawnUsesItsOriginalArmyGeometry() {
+        val pawn = piece("red-pawn", PieceType.PAWN, ArmyColor.RED, "D5")
+        val moved = pawn.copy(coordinate = at("D4"))
+        val geometry = Position(mapOf(moved.id to moved))
+        val originalArmyAttacks = LegalMoveGenerator.attackCoordinates(geometry, moved)
+        val controllerArmyAttacks = LegalMoveGenerator.attackCoordinates(geometry, moved.copy(army = ArmyColor.WHITE))
+        val target = originalArmyAttacks.first { it !in controllerArmyAttacks }
+        val pieces = listOf(pawn, piece("white-king", PieceType.KING, ArmyColor.WHITE, "H12"),
+            Piece(PieceId("black-king"), PieceType.KING, ArmyColor.BLACK, target, hasMoved = true))
+        val state = GameState(Position(pieces.associateBy(Piece::id)),
+            PlayerId.entries.associateWith { actor -> Participant(actor, if (actor == PlayerId.RED) {
+                ParticipantStatus.Checkmated(by = PlayerId.WHITE, atPly = 1)
+            } else ParticipantStatus.Active) },
+            ArmyColor.entries.associateWith { army -> ArmyControl(army,
+                if (army == ArmyColor.RED) PlayerId.WHITE else army.originalPlayer) },
+            Turn(PlayerId.WHITE, 2), GamePhase.InProgress)
+        val move = LegalMoveGenerator.legalMoves(state).single { it.pieceId == pawn.id && it.to == at("D4") }
+        assertTrue(directCheckPriorities(state, listOf(move)).getValue(move))
+        assertTrue(LegalMoveGenerator.isKingInCheck(apply(state, move), PlayerId.BLACK))
+    }
+
+    @Test
+    fun promotionsUseTheResultingPieceInsteadOfThePawn() {
+        val state = state(PlayerId.WHITE, listOf(
+            piece("white-king", PieceType.KING, ArmyColor.WHITE, "H12"),
+            piece("red-king", PieceType.KING, ArmyColor.RED, "A1"),
+            piece("black-king", PieceType.KING, ArmyColor.BLACK, "N12"),
+            piece("white-pawn", PieceType.PAWN, ArmyColor.WHITE, "K11"),
+        ))
+        val moves = LegalMoveGenerator.legalMoves(state).filter { it.from == at("K11") && it.to == at("K12") }
+        assertEquals(PromotionChoice.entries.toSet(), moves.map { it.promotion }.toSet())
+        val priorities = directCheckPriorities(state, moves)
+        assertTrue(priorities.getValue(moves.single { it.promotion == PromotionChoice.ROOK }))
+        assertTrue(priorities.getValue(moves.single { it.promotion == PromotionChoice.QUEEN }))
+        assertFalse(priorities.getValue(moves.single { it.promotion == PromotionChoice.KNIGHT }))
+        assertFalse(priorities.getValue(moves.single { it.promotion == PromotionChoice.BISHOP }))
+    }
+
+    @Test
+    fun aDiscoveredCheckMayRemainAFalseNegativeBecauseTheHintIsDirectOnly() {
+        val state = state(PlayerId.WHITE, listOf(
+            piece("white-king", PieceType.KING, ArmyColor.WHITE, "A1"),
+            piece("red-king", PieceType.KING, ArmyColor.RED, "N8"),
+            piece("black-king", PieceType.KING, ArmyColor.BLACK, "G12"),
+            piece("white-rook", PieceType.ROOK, ArmyColor.WHITE, "G10"),
+            piece("white-knight", PieceType.KNIGHT, ArmyColor.WHITE, "G11"),
+        ))
+        val move = LegalMoveGenerator.legalMoves(state).single { it.from == at("G11") && it.to == at("E10") }
+        assertFalse(directCheckPriorities(state, listOf(move)).getValue(move))
+        assertTrue(LegalMoveGenerator.isKingInCheck(apply(state, move), PlayerId.BLACK))
+    }
+
+    @Test
+    fun quietMovesWithoutAnAttackHaveFalseHints() {
+        val state = state(PlayerId.WHITE, listOf(
+            piece("white-king", PieceType.KING, ArmyColor.WHITE, "H12"),
+            piece("red-king", PieceType.KING, ArmyColor.RED, "A1"),
+            piece("black-king", PieceType.KING, ArmyColor.BLACK, "N8"),
+            piece("white-pawn", PieceType.PAWN, ArmyColor.WHITE, "K9"),
+        ))
+        val moves = LegalMoveGenerator.legalMoves(state)
+        assertTrue(moves.isNotEmpty())
+        assertTrue(directCheckPriorities(state, moves).values.none { it })
+        assertTrue(directCheckPriorities(state, emptyList()).isEmpty())
+    }
+
+    // Board geometry before reported ply 144. Rights are omitted and flags set to moved;
+    // this is a focused legal reconstruction, not a replacement for the export replay.
+    private fun reportedKnightFork(whiteStatus: ParticipantStatus = ParticipantStatus.Active): GameState {
+        val pieces = """
+            black-back-0:BLACK:ROOK:n12;black-back-1:BLACK:KNIGHT:n10;black-back-2:BLACK:BISHOP:m11;
+            black-back-3:BLACK:QUEEN:m10;black-back-4:BLACK:KING:e11;black-back-5:BLACK:BISHOP:k10;
+            black-back-6:BLACK:KNIGHT:h10;black-back-7:BLACK:ROOK:h12;black-pawn-0:BLACK:PAWN:n9;
+            black-pawn-1:BLACK:PAWN:m9;black-pawn-2:BLACK:PAWN:l10;black-pawn-3:BLACK:PAWN:k9;
+            black-pawn-4:BLACK:PAWN:e10;black-pawn-5:BLACK:PAWN:f10;black-pawn-6:BLACK:PAWN:g10;
+            black-pawn-7:BLACK:PAWN:h9;red-back-0:RED:ROOK:d8;red-back-1:RED:KNIGHT:a5;
+            red-back-2:RED:BISHOP:b7;red-back-3:RED:KING:b8;red-back-4:RED:QUEEN:k8;
+            red-back-5:RED:BISHOP:m7;red-back-6:RED:KNIGHT:k6;red-back-7:RED:ROOK:n8;
+            red-pawn-0:RED:PAWN:a7;red-pawn-1:RED:PAWN:b6;red-pawn-2:RED:PAWN:c5;
+            red-pawn-3:RED:PAWN:d7;red-pawn-4:RED:PAWN:k5;red-pawn-5:RED:PAWN:l6;
+            red-pawn-6:RED:PAWN:m6;red-pawn-7:RED:PAWN:n7;white-back-0:WHITE:ROOK:h1;
+            white-back-1:WHITE:KNIGHT:f3;white-back-2:WHITE:BISHOP:e2;white-back-3:WHITE:KING:h2;
+            white-back-4:WHITE:QUEEN:f2;white-back-6:WHITE:KNIGHT:d2;white-back-7:WHITE:ROOK:a1;
+            white-pawn-0:WHITE:PAWN:h4;white-pawn-1:WHITE:PAWN:g3;white-pawn-2:WHITE:PAWN:f4;
+            white-pawn-3:WHITE:PAWN:e4;white-pawn-5:WHITE:PAWN:c4;white-pawn-6:WHITE:PAWN:b5;
+            white-pawn-7:WHITE:PAWN:a4
+        """.trimIndent().replace("\n", "").split(';').map { token ->
+            val (id, army, type, square) = token.trim().split(':')
+            piece(id, PieceType.valueOf(type), ArmyColor.valueOf(army), square)
+        }
+        return GameState(Position(pieces.associateBy(Piece::id)),
+            PlayerId.entries.associateWith { actor ->
+                Participant(actor, if (actor == PlayerId.WHITE) whiteStatus else ParticipantStatus.Active)
+            }, ArmyColor.entries.associateWith { ArmyControl(it, it.originalPlayer) },
+            Turn(PlayerId.BLACK, 144), GamePhase.InProgress)
+    }
+
+    private fun state(actor: PlayerId, pieces: List<Piece>) = GameState(
+        Position(pieces.associateBy(Piece::id)), PlayerId.entries.associateWith(::Participant),
+        ArmyColor.entries.associateWith { ArmyControl(it, it.originalPlayer) }, Turn(actor, 1), GamePhase.InProgress,
+    )
+
+    private fun piece(id: String, type: PieceType, army: ArmyColor, label: String) =
+        Piece(PieceId(id), type, army, at(label), hasMoved = true)
+
+    private fun at(label: String) = checkNotNull(ThreePlayerBoardNotation.parse(label))
+    private fun apply(state: GameState, move: Move) = assertIs<MoveReduction.Applied>(GameReducer.reduce(
+        state, MoveIntent(move.actor, move.from, move.to, move.promotion),
+    )).state
+}
