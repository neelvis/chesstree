+    private data class Observation(
+        val result: BoundedBotResult,
+        val publications: List<BoundedBotResult.Move>,
+        val fallback: List<MoveIntent>,
+        val diagnostics: BotSearchDiagnostics?,
+        val probes: Int,
+    )
+
+    private fun observe(state: GameState, model: BotSearchModel, enabled: Boolean, tacticalDepth: Int): Observation {
+        val publications = mutableListOf<BoundedBotResult.Move>()
+        val fallback = mutableListOf<MoveIntent>()
+        var diagnostics: BotSearchDiagnostics? = null
+        var probes = 0
+        val result = BoundedMaxNBot(maxDepth = 3, maxNodes = 20_000, maxEvaluations = 20_000,
+            tacticalDepth = tacticalDepth, searchModel = model).chooseWithDiagnostics(state,
+            stop = BotStopProbe { probes++; BotStopSignal.CONTINUE },
+            onFallbackReady = fallback::add, onCompletedDepth = publications::add,
+            prioritizeDirectChecks = enabled, diagnostics = { diagnostics = it })
+        return Observation(result, publications.toList(), fallback.toList(), diagnostics, probes)
+    }
+
+    private fun bot(cache: BotSearchCache? = null) = BoundedMaxNBot(
+        maxDepth = 3, maxNodes = 100_000, maxEvaluations = 100_000,
+        searchModel = BotSearchModel.PARANOID, cache = cache,
+    )
+
+    private fun completed(state: GameState, policy: BotPolicy, enabled: Boolean, cache: BotSearchCache? = null) =
+        assertIs<BoundedBotResult.Move>(bot(cache).chooseWithDiagnostics(state, policy,
+            prioritizeDirectChecks = enabled, diagnostics = {}))
+
+    private fun assertDecision(expected: BoundedBotResult.Move, actual: BoundedBotResult.Move) {
+        assertEquals(expected.intent, actual.intent)
+        assertEquals(expected.source, actual.source)
+        assertEquals(expected.reason, actual.reason)
+        assertEquals(expected.stats.completedDepth, actual.stats.completedDepth)
+        assertEquals(expected.stats.completedHorizon, actual.stats.completedHorizon)
+        assertEquals(expected.openingBook, actual.openingBook)
+        assertEquals(expected.repetitionPenalty, actual.repetitionPenalty)
+    }
+
+    private fun exhaustiveRoot(state: GameState, depth: Int, policy: BotPolicy): MoveIntent {
+        val actor = checkNotNull(state.turn).player
+        return checkNotNull(LegalMoveGenerator.legalMoves(state).map { move ->
+            move to exhaustive(apply(state, move), depth - 1, actor, policy)
+        }.maxByOrNull { it.second }).first.intent()
+    }
+
+    private fun exhaustive(state: GameState, depth: Int, root: PlayerId, policy: BotPolicy): Double {
+        if (depth == 0 || state.phase != GamePhase.InProgress) {
+            return BotEvaluationMode.CONTROL.evaluate(state, policy)[root.ordinal]
+        }
+        val actor = checkNotNull(state.turn).player
+        val values = LegalMoveGenerator.legalMoves(state).map { move ->
+            exhaustive(apply(state, move), depth - 1, root, policy)
+        }
+        return if (actor == root) values.max() else values.min()
+    }
+
+    private fun checkFixture(actor: PlayerId = PlayerId.WHITE): GameState {
+        val original = listOf(
+            piece("a-white-rook", PieceType.ROOK, ArmyColor.WHITE, "G10"),
+            piece("white-king", PieceType.KING, ArmyColor.WHITE, "F12"),
+            piece("red-pawn", PieceType.PAWN, ArmyColor.RED, "G12"),
+            piece("red-king", PieceType.KING, ArmyColor.RED, "A2"),
+            piece("black-bishop", PieceType.BISHOP, ArmyColor.BLACK, "H11"),
+            piece("black-king", PieceType.KING, ArmyColor.BLACK, "H12"),
+        )
+        val rotated = original.map { piece ->
+            piece.copy(army = ArmyColor.entries[(piece.army.ordinal + actor.ordinal) % ArmyColor.entries.size])
+        }
+        return state(actor, rotated)
+    }
+
+    private fun quietFixture(): GameState = state(PlayerId.WHITE, listOf(
+        piece("white-king", PieceType.KING, ArmyColor.WHITE, "H12"),
+        piece("red-king", PieceType.KING, ArmyColor.RED, "A1"),
+        piece("black-king", PieceType.KING, ArmyColor.BLACK, "N8"),
+        piece("white-pawn", PieceType.PAWN, ArmyColor.WHITE, "K9"),
+        piece("red-pawn", PieceType.PAWN, ArmyColor.RED, "D3"),
+        piece("black-pawn", PieceType.PAWN, ArmyColor.BLACK, "K6"),
+    ))
+
+    private fun state(actor: PlayerId, pieces: List<Piece>) = GameState(
+        Position(pieces.associateBy(Piece::id)), PlayerId.entries.associateWith(::Participant),
+        ArmyColor.entries.associateWith { ArmyControl(it, it.originalPlayer) }, Turn(actor, 1), GamePhase.InProgress,
+    )
+
+    private fun piece(id: String, type: PieceType, army: ArmyColor, square: String) =
+        Piece(PieceId(id), type, army, at(square), hasMoved = true)
+
+    private fun at(square: String) = checkNotNull(ThreePlayerBoardNotation.parse(square))
+    private fun Move.intent() = MoveIntent(actor, from, to, promotion)
+    private fun apply(state: GameState, move: Move): GameState =
+        assertIs<MoveReduction.Applied>(GameReducer.reduce(state, move.intent())).state
