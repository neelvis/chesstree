+    @Test
+    fun interruptionDuringRootHintConstructionCannotPublishPartialWork() {
+        for (signal in listOf(BotStopSignal.CANCEL, BotStopSignal.TIMEOUT)) {
+            var probes = 0
+            val publications = mutableListOf<BoundedBotResult.Move>()
+            val fallback = mutableListOf<MoveIntent>()
+            val result = bot().chooseWithDiagnostics(checkFixture(), stop = BotStopProbe {
+                probes++
+                // Two entry probes and the root node precede the first per-move hint probe.
+                if (probes >= 4) signal else BotStopSignal.CONTINUE
+            }, onFallbackReady = fallback::add, onCompletedDepth = publications::add,
+                prioritizeDirectChecks = true, diagnostics = {})
+            assertEquals(1, fallback.size)
+            assertTrue(publications.isEmpty())
+            if (signal == BotStopSignal.CANCEL) {
+                assertEquals(0, assertIs<BoundedBotResult.Cancelled>(result).stats.completedDepth)
+            } else {
+                val move = assertIs<BoundedBotResult.Move>(result)
+                assertEquals(BotStopReason.TIMEOUT, move.reason)
+                assertEquals(BotMoveSource.LEGAL_FALLBACK, move.source)
+                assertEquals(fallback.single(), move.intent)
+                assertEquals(0, move.stats.completedDepth)
+            }
+        }
+    }
