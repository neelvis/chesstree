+
+class BotCertifiedHorizonReuseTest {
+    private data class Observation(
+        val result: BoundedBotResult,
+        val completed: List<BoundedBotResult.Move>,
+        val diagnostics: BotSearchDiagnostics,
+    )
+
+    @Test
+    fun quietThreePlayerSubtreesProduceRealAliasesAndSaveActualWork() {
+        val state = quiet()
+        val control = observe(state, reuse = false, cache = BotSearchCache())
+        val candidate = observe(state, reuse = true, cache = BotSearchCache())
+        assertEquivalent(control, candidate)
+        assertComplete(candidate, depth = 2, tacticalDepth = 2)
+        assertTrue(candidate.diagnostics.horizonReuse.certificatesStored > 0)
+        assertTrue(candidate.diagnostics.horizonReuse.aliasHits > 0)
+        val before = assertIs<BoundedBotResult.Move>(control.result).stats
+        val after = assertIs<BoundedBotResult.Move>(candidate.result).stats
+        assertTrue(after.expandedNodes < before.expandedNodes || after.leafEvaluations < before.leafEvaluations,
+            "Aliases must replace actual search work, not only increment a counter")
+    }
+
+    @Test
+    fun fullyCompletedSparseSearchesMatchEveryAttemptAcrossAllSeatsModelsAndModes() {
+        for (actor in PlayerId.entries) {
+            for (model in BotSearchModel.entries) {
+                for (mode in BotEvaluationMode.entries) {
+                    for (q in listOf(0, 2)) {
+                        val state = quiet(actor)
+                        val control = observe(state, false, BotSearchCache(), model, mode, q)
+                        val candidate = observe(state, true, BotSearchCache(), model, mode, q)
+                        assertEquivalent(control, candidate)
+                        assertComplete(control, 2, q)
+                        assertComplete(candidate, 2, q)
+                        assertEquals(if (q == 0) 2 else 4, candidate.completed.size)
+                        if (q == 0) assertEquals(0, candidate.diagnostics.horizonReuse.aliasHits)
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    fun captureAndInterveningResponderFrontiersCannotBeCertifiedAsQuiet() {
+        var divergent = 0
+        for (state in listOf(forcedRecapture(), uncheckedRecapture())) {
