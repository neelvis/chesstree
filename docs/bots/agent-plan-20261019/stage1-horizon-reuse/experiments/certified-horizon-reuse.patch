+    @Test
+    fun cancellationAndTimeoutAfterACompletedCallbackRetainTheirAuthority() {
+        for (signal in listOf(BotStopSignal.CANCEL, BotStopSignal.TIMEOUT)) {
+            val control = observe(quiet(), false, BotSearchCache(), afterCompleted = signal)
+            val candidate = observe(quiet(), true, BotSearchCache(), afterCompleted = signal)
+            assertEquivalent(control, candidate)
+            assertEquals(1, candidate.completed.size)
+            if (signal == BotStopSignal.CANCEL) {
+                assertIs<BoundedBotResult.Cancelled>(candidate.result)
+            } else {
+                val move = assertIs<BoundedBotResult.Move>(candidate.result)
+                assertEquals(BotStopReason.TIMEOUT, move.reason)
+                assertEquals(BotMoveSource.COMPLETED_DEPTH, move.source)
+                assertEquals(candidate.completed.single().intent, move.intent)
+            }
+            val completedCache = BotSearchCache()
+            observe(quiet(), true, completedCache, afterCompleted = signal)
+            assertEquivalent(observe(quiet(), false, null), observe(quiet(), true, completedCache))
+        }
+    }
+
+    private fun observe(
+        state: GameState,
+        reuse: Boolean,
+        cache: BotSearchCache?,
+        model: BotSearchModel = BotSearchModel.MAX_N,
+        mode: BotEvaluationMode = BotEvaluationMode.CONTROL,
+        tacticalDepth: Int = 2,
+        maxDepth: Int = 2,
+        maxNodes: Int = 20_000,
+        maxEvaluations: Int = 20_000,
+        policy: BotPolicy = BotPolicy.DEFAULT,
+        afterCompleted: BotStopSignal = BotStopSignal.CONTINUE,
+    ): Observation {
+        val completed = mutableListOf<BoundedBotResult.Move>()
+        var diagnostics: BotSearchDiagnostics? = null
+        val result = BoundedMaxNBot(
+            maxDepth = maxDepth, maxNodes = maxNodes, maxEvaluations = maxEvaluations,
+            tacticalDepth = tacticalDepth, searchModel = model, evaluation = mode, cache = cache,
+        ).chooseWithDiagnostics(
+            state, policy,
+            stop = BotStopProbe { if (completed.isEmpty()) BotStopSignal.CONTINUE else afterCompleted },
+            onCompletedDepth = completed::add,
+            reuseCertifiedHorizons = reuse,
+            diagnostics = { diagnostics = it },
+        )
+        val move = result as? BoundedBotResult.Move
+        if (move != null) apply(state, move.intent)
+        return Observation(result, completed.toList(), checkNotNull(diagnostics))
+    }
+
+    private fun assertEquivalent(control: Observation, candidate: Observation) {
+        assertEquals(normalize(control.result), normalize(candidate.result))
+        assertEquals(control.completed.map(::normalize), candidate.completed.map(::normalize))
+        assertEquals(control.diagnostics.attempts.map { Triple(it.depth, it.horizon, it.stop) },
+            candidate.diagnostics.attempts.map { Triple(it.depth, it.horizon, it.stop) })
+    }
+
+    private fun normalize(result: BoundedBotResult): BoundedBotResult = when (result) {
+        is BoundedBotResult.Move -> result.copy(stats = result.stats.copy(expandedNodes = 0, leafEvaluations = 0))
+        is BoundedBotResult.Cancelled -> result.copy(stats = result.stats.copy(expandedNodes = 0, leafEvaluations = 0))
+        else -> result
+    }
+
+    private fun assertComplete(observation: Observation, depth: Int, tacticalDepth: Int) {
+        val move = assertIs<BoundedBotResult.Move>(observation.result)
+        assertEquals(BotStopReason.DEPTH_COMPLETE, move.reason)
+        assertEquals(BotMoveSource.COMPLETED_DEPTH, move.source)
+        assertEquals(depth, move.stats.completedDepth)
+        assertEquals(if (tacticalDepth == 0) BotSearchHorizon.STATIC else BotSearchHorizon.EXCHANGES,
+            move.stats.completedHorizon)
+    }
+
+    private fun quiet(actor: PlayerId = PlayerId.WHITE) = state(
+        piece("white-king", PieceType.KING, ArmyColor.WHITE, "H12"),
+        piece("red-king", PieceType.KING, ArmyColor.RED, "A1"),
+        piece("black-king", PieceType.KING, ArmyColor.BLACK, "N8"),
+        actor = actor,
+    )
+
+    private fun forcedRecapture() = state(
+        piece("white-rook", PieceType.ROOK, ArmyColor.WHITE, "G10"),
+        piece("white-king", PieceType.KING, ArmyColor.WHITE, "F12"),
+        piece("red-pawn", PieceType.PAWN, ArmyColor.RED, "G12"),
+        piece("red-king", PieceType.KING, ArmyColor.RED, "A2"),
+        piece("black-bishop", PieceType.BISHOP, ArmyColor.BLACK, "H11"),
+        piece("black-king", PieceType.KING, ArmyColor.BLACK, "H12"),
+    )
+
+    private fun uncheckedRecapture() = state(
+        piece("white-rook", PieceType.ROOK, ArmyColor.WHITE, "D4"),
+        piece("white-king", PieceType.KING, ArmyColor.WHITE, "H12"),
+        piece("red-pawn", PieceType.PAWN, ArmyColor.RED, "E4"),
+        piece("red-king", PieceType.KING, ArmyColor.RED, "B1"),
+        piece("black-rook", PieceType.ROOK, ArmyColor.BLACK, "F4"),
+        piece("black-king", PieceType.KING, ArmyColor.BLACK, "N7"),
+    )
+
+    private fun defense() = state(
+        *quiet().position.pieces.values.toTypedArray(),
+        piece("red-rook", PieceType.ROOK, ArmyColor.RED, "H10"),
+    )
+
+    private fun mateTransfer() = state(
+        piece("white-king", PieceType.KING, ArmyColor.WHITE, "F12"),
+        piece("white-queen", PieceType.QUEEN, ArmyColor.WHITE, "G11"),
+        piece("red-king", PieceType.KING, ArmyColor.RED, "H12"),
+        piece("black-king", PieceType.KING, ArmyColor.BLACK, "N8"),
+    )
+
+    private fun finalMate(): GameState = GameState(
+        Position(listOf(
+            piece("white-king", PieceType.KING, ArmyColor.WHITE, "F12"),
+            piece("white-queen", PieceType.QUEEN, ArmyColor.WHITE, "G11"),
+            piece("black-king", PieceType.KING, ArmyColor.BLACK, "H12"),
+        ).associateBy(Piece::id)),
+        PlayerId.entries.associateWith {
+            Participant(it, if (it == PlayerId.RED) ParticipantStatus.Checkmated(PlayerId.WHITE, 1)
+            else ParticipantStatus.Active)
+        },
+        ArmyColor.entries.associateWith {
+            ArmyControl(it, if (it == ArmyColor.BLACK) PlayerId.BLACK else PlayerId.WHITE)
+        },
+        Turn(PlayerId.WHITE, 2), GamePhase.InProgress,
+    )
+
+    private fun promotion() = state(
+        *quiet().position.pieces.values.toTypedArray(),
+        piece("white-pawn", PieceType.PAWN, ArmyColor.WHITE, "K11"),
+    )
+
+    private fun state(vararg pieces: Piece, actor: PlayerId = PlayerId.WHITE) = GameState(
+        Position(pieces.associateBy(Piece::id)), PlayerId.entries.associateWith(::Participant),
+        ArmyColor.entries.associateWith { ArmyControl(it, it.originalPlayer) },
+        Turn(actor, 1), GamePhase.InProgress,
+    )
+
+    private fun piece(id: String, type: PieceType, army: ArmyColor, square: String) =
+        Piece(PieceId(id), type, army, at(square), hasMoved = true)
+
+    private fun at(square: String) = checkNotNull(ThreePlayerBoardNotation.parse(square))
+
+    private fun intent(actor: PlayerId, from: String, to: String) = MoveIntent(actor, at(from), at(to))
+
+    private fun apply(state: GameState, intent: MoveIntent): GameState =
+        assertIs<MoveReduction.Applied>(GameReducer.reduce(state, intent)).state
+}
