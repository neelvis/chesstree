+    private fun incompatibleStates(base: GameState): List<GameState> {
+        val pawn = base.position.pieces.values.first { it.type == PieceType.PAWN }
+        val moved = pawn.copy(hasMoved = !pawn.hasMoved)
+        val promoted = pawn.copy(type = PieceType.KNIGHT, hasMoved = true)
+        return listOf(
+            state(base.position, turn = Turn(PlayerId.WHITE, checkNotNull(base.turn).ply + 1)),
+            state(base.position, turn = Turn(PlayerId.RED, checkNotNull(base.turn).ply)),
+            state(Position(base.position.pieces, castlingRights = base.position.castlingRights.drop(1).toSet()), turn = base.turn),
+            state(Position(base.position.pieces, base.position.castlingRights, enPassantTarget = EnPassantTarget(
+                pawn.id, checkNotNull(ThreePlayerBoardNotation.parse("K10")), setOf(PlayerId.RED),
+            )), turn = base.turn),
+            state(Position(base.position.pieces + (pawn.id to moved), base.position.castlingRights), turn = base.turn),
+            state(Position(base.position.pieces + (pawn.id to promoted), base.position.castlingRights), turn = base.turn),
+            state(base.position, participants = base.participants +
+                (PlayerId.RED to Participant(PlayerId.RED, ParticipantStatus.Stalemated(1))), turn = base.turn),
+            state(base.position, armies = base.armies +
+                (ArmyColor.RED to ArmyControl(ArmyColor.RED, PlayerId.WHITE)), turn = base.turn),
+        )
+    }
+
+    private fun configuration() = BotSearchCache.Configuration(
+        BotPolicy.DEFAULT.rules.toList(), BotEvaluationMode.POSITIONAL, BotSearchModel.PARANOID, PlayerId.WHITE, 4,
+    )
+
+    private fun normalKey(ply: Int = 10) = BotSearchCache.SearchKey(
+        state(turn = Turn(PlayerId.WHITE, ply)), configuration(), 2, BotSearchHorizon.EXCHANGES, emptySet(),
+    )
+
+    private fun tacticalKey(ply: Int = 10) = BotSearchCache.SearchKey(
+        state(turn = Turn(PlayerId.WHITE, ply)), configuration(), 0, BotSearchHorizon.EXCHANGES,
+        setOf(PlayerId.BLACK), remaining = 2, allowNewExchange = false,
+    )
+
+    private fun state(
+        position: Position = initial.position,
+        participants: Map<PlayerId, Participant> = initial.participants,
+        armies: Map<ArmyColor, ArmyControl> = initial.armies,
+        turn: Turn? = initial.turn,
+    ) = GameState(position, participants, armies, turn, GamePhase.InProgress)
+
+    companion object {
+        private val initial = StandardGame.scenario.initialState
+        private val SCORES = doubleArrayOf(1.0, 2.0, 3.0)
+    }
+}
