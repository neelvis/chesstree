+    @Test
+    fun globalCapsRetainOnlyActuallyCompletedRootDecisions() {
+        for ((nodes, evaluations, expected) in listOf(
+            Triple(1, 20_000, BotStopReason.NODE_LIMIT),
+            Triple(20_000, 1, BotStopReason.EVALUATION_LIMIT),
+        )) {
+            val control = observe(quiet(), false, BotSearchCache(), maxNodes = nodes, maxEvaluations = evaluations)
+            val candidate = observe(quiet(), true, BotSearchCache(), maxNodes = nodes, maxEvaluations = evaluations)
+            assertEquivalent(control, candidate)
+            val move = assertIs<BoundedBotResult.Move>(candidate.result)
+            assertEquals(expected, move.reason)
+            if (expected == BotStopReason.NODE_LIMIT) {
+                // The first CHECKS root needs one node: every child is a static leaf.
+                // Its completed decision survives the cap before the EXCHANGES attempt.
+                val completed = candidate.completed.single()
+                assertEquals(BotMoveSource.COMPLETED_DEPTH, move.source)
+                assertEquals(1, move.stats.completedDepth)
+                assertEquals(BotSearchHorizon.CHECKS, move.stats.completedHorizon)
+                assertEquals(completed.intent, move.intent)
+            } else {
+                // More than one root move needs evaluation, so one leaf cannot finish the root.
+                assertTrue(LegalMoveGenerator.legalMoves(quiet()).size > 1)
+                assertEquals(BotMoveSource.LEGAL_FALLBACK, move.source)
+                assertEquals(0, move.stats.completedDepth)
+                assertTrue(candidate.completed.isEmpty())
+            }
+        }
+    }
