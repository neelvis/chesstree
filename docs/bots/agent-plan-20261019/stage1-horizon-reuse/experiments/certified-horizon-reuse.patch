+                val control = observe(state, false, BotSearchCache(), model, maxDepth = 1)
+                val candidate = observe(state, true, BotSearchCache(), model, maxDepth = 1)
+                assertEquivalent(control, candidate)
+                divergent += candidate.diagnostics.horizonReuse.divergentFrontiers
+            }
+        }
+        assertTrue(divergent > 0, "At least one actual capture-response frontier must reject certification")
+
+        // A public-reducer line establishes why an unchecked capture needs both real responses.
+        val afterCapture = apply(uncheckedRecapture(), intent(PlayerId.WHITE, "D4", "E4"))
+        assertTrue(PlayerId.entries.none { LegalMoveGenerator.isKingInCheck(afterCapture, it) })
+        val afterRed = apply(afterCapture, intent(PlayerId.RED, "B1", "A1"))
+        val afterBlack = apply(afterRed, intent(PlayerId.BLACK, "F4", "E4"))
+        assertFalse(PieceId("white-rook") in afterBlack.position.pieces)
+        assertEquals(PlayerId.WHITE, afterBlack.turn?.player)
+    }
