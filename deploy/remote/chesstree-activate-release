#!/usr/bin/env bash

set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

if [[ $# -ne 1 ]]; then
    printf 'Usage: %s <release-id>\n' "$0" >&2
    exit 1
fi

release_id="$1"
if [[ ! "$release_id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,40}$ ]]; then
    printf 'Invalid release id: %s\n' "$release_id" >&2
    exit 1
fi

deploy_user=elvis
remote_root=/opt/chesstree
staging="/home/$deploy_user/chesstree-upload/$release_id"
release_dir="$remote_root/releases/$release_id"
current_link="$remote_root/current"
staged_firebase_key="$staging/secrets/firebase-service-account.json"
staged_nginx_config="$staging/infra/nginx/chesstree.conf"
nginx_config=/etc/nginx/sites-available/chesstree
nginx_config_backup=""
nginx_config_had_previous=false
nginx_config_updated=false
firebase_key=/etc/chesstree/secrets/firebase-service-account.json
firebase_secrets_dir=/etc/chesstree/secrets
server_env=/etc/chesstree/server.env
server_env_tmp=""

cleanup_staged_firebase_key() {
    restore_nginx_config
    rm -f "$staged_firebase_key"
    rmdir "$staging/secrets" 2>/dev/null || true
    if [[ -n "$nginx_config_backup" ]]; then
        rm -f "$nginx_config_backup"
    fi
    if [[ -n "$server_env_tmp" ]]; then
        rm -f "$server_env_tmp"
    fi
}

restore_nginx_config() {
    if [[ "$nginx_config_updated" != true ]]; then
        return
    fi
    if [[ "$nginx_config_had_previous" == true ]]; then
        mv -f "$nginx_config_backup" "$nginx_config"
        nginx_config_backup=""
    else
        rm -f "$nginx_config"
    fi
    nginx_config_updated=false
}
trap cleanup_staged_firebase_key EXIT

test -d "$staging/web"
test -x "$staging/server/bin/server"
test -f "$staged_nginx_config"
if [[ -s "$staged_firebase_key" || -f "$firebase_key" ]]; then
    install -d -o root -g chesstree -m 750 "$firebase_secrets_dir"
    chown root:chesstree "$firebase_secrets_dir"
    chmod 750 "$firebase_secrets_dir"
fi
if [[ -s "$staged_firebase_key" ]]; then
    install -o root -g chesstree -m 640 "$staged_firebase_key" \
        "$firebase_key"
fi
if [[ -f "$firebase_key" ]]; then
    chown root:chesstree "$firebase_key"
    chmod 640 "$firebase_key"
    if [[ "$(stat -c '%U:%G:%a' "$firebase_key")" != "root:chesstree:640" ]]; then
        printf 'Unexpected Firebase key owner or mode: %s\n' "$firebase_key" >&2
        exit 1
    fi
fi

test -f "$server_env"
server_env_tmp="$(mktemp /etc/chesstree/server.env.XXXXXX)"
awk '!/^CHESSTREE_FCM_SERVICE_ACCOUNT_FILE=/' "$server_env" > "$server_env_tmp"
printf '%s\n' \
    'CHESSTREE_FCM_SERVICE_ACCOUNT_FILE=/etc/chesstree/secrets/firebase-service-account.json' \
    >> "$server_env_tmp"
chown --reference="$server_env" "$server_env_tmp"
chmod --reference="$server_env" "$server_env_tmp"
mv -f "$server_env_tmp" "$server_env"
server_env_tmp=""

install -d -m 755 "$remote_root/releases" "$release_dir/web" "$release_dir/server"
rsync -a --delete "$staging/web/" "$release_dir/web/"
rsync -a --delete "$staging/server/" "$release_dir/server/"
chown -R root:root "$release_dir"

previous_release=""
if [[ -L "$current_link" ]]; then
    resolved_release="$(readlink -e "$current_link" 2>/dev/null || true)"
    case "$resolved_release" in
        "$remote_root"/releases/*) previous_release="$resolved_release" ;;
    esac
fi
if [[ -f "$nginx_config" ]]; then
    nginx_config_backup="$(mktemp /etc/nginx/sites-available/.chesstree.XXXXXX)"
    cp -a "$nginx_config" "$nginx_config_backup"
    nginx_config_had_previous=true
fi
ln -sfn "$release_dir" "$remote_root/current.next"
mv -Tf "$remote_root/current.next" "$current_link"

rollback() {
    restore_nginx_config
    if [[ -n "$previous_release" && -d "$previous_release" ]]; then
        ln -sfn "$previous_release" "$remote_root/current.rollback"
        mv -Tf "$remote_root/current.rollback" "$current_link"
        systemctl restart chesstree-server || true
    else
        systemctl stop chesstree-server || true
        if [[ "$(readlink -e "$current_link" 2>/dev/null || true)" == "$release_dir" ]]; then
            unlink "$current_link"
        fi
    fi
}

nginx_config_updated=true
if ! install -o root -g root -m 644 "$staged_nginx_config" "$nginx_config"; then
    rollback
    exit 1
fi

if ! nginx -t; then
    rollback
    exit 1
fi
if ! systemctl restart chesstree-server; then
    rollback
    exit 1
fi

healthy=false
for _ in {1..20}; do
    if curl --fail --silent --show-error http://127.0.0.1:8081/health >/dev/null; then
        healthy=true
        break
    fi
    sleep 1
done

if [[ "$healthy" != true ]]; then
    journalctl -u chesstree-server -n 100 --no-pager || true
    rollback
    exit 1
fi

if ! systemctl reload nginx; then
    rollback
    nginx -t && systemctl reload nginx || true
    exit 1
fi
nginx_config_updated=false
if [[ -n "$nginx_config_backup" ]]; then
    rm -f "$nginx_config_backup"
    nginx_config_backup=""
fi
printf 'Activated release %s.\n' "$release_id"
