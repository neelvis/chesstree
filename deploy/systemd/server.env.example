CHESSTREE_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/chesstree
CHESSTREE_DATABASE_USER=chesstree
CHESSTREE_DATABASE_PASSWORD=replace-with-a-secret
CHESSTREE_PUBLIC_BASE_URL=https://chess-tree.online
CHESSTREE_CORS_HOSTS=chess-tree.online
# Optional. Store the real Firebase service-account JSON outside the web root.
CHESSTREE_FCM_SERVICE_ACCOUNT_FILE=/etc/chesstree/secrets/firebase-service-account.json
PORT=8081
