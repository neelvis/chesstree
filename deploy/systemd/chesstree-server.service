[Unit]
Description=ChessTree Ktor backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=chesstree
Group=chesstree
WorkingDirectory=/opt/chesstree/current/server
EnvironmentFile=/etc/chesstree/server.env
ExecStart=/opt/chesstree/current/server/bin/server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
